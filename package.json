{
  "name": "world-animals",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "desktop": "vite build && electron .",
    "dist:win": "vite build && electron-builder --win --x64"
  },
  "devDependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-legacy": "^8.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "d3-geo": "^3.1.1",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.81.0",
    "polygon-clipping": "^0.15.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.5",
    "terser": "^5.51.2",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "description": "Animals of the World – picture map of animals for small kids (EN/CS)",
  "author": "Jay Trepka",
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.jaytrepka.worldanimals",
    "productName": "Zvířata světa",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/smoke-test.cjs",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "electron/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Zvířata světa",
      "artifactName": "Zvirata-sveta-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Zvirata-sveta-portable-${version}.${ext}"
    }
  }
}
